# Naming a site gets HTTPS and the HTTP redirect automatically: a real domain from Let's Encrypt,
# localhost from Caddy's own internal certificate.
{$SITE_DOMAIN} {
	reverse_proxy app:8080 {
		# Send every byte straight on, so /live events arrive as they happen
		flush_interval -1

		# Caddy replaces X-Forwarded-For, -Proto and -Host itself. The app also believes these,
		# which Caddy would pass through as the client sent them, so remove them.
		header_up -Forwarded
		header_up -X-Forwarded-Port
		header_up -X-Forwarded-Prefix
		header_up -X-Forwarded-Ssl
	}
}
