# What docker-compose.prod.yml needs. Copy this to .env.prod and fill it in: that file is gitignored.
# Single-quote any value containing $, or compose will try to expand it.

# The site's domain. Use localhost to try the stack on a laptop with Caddy's internal certificate.
SITE_DOMAIN=arena.example.com
# The app image to run
APP_IMAGE=registry.example.com/arena:tag

SPRING_DATASOURCE_URL=jdbc:postgresql://db.example.com:5432/arena
SPRING_DATASOURCE_USERNAME=change-me
SPRING_DATASOURCE_PASSWORD=change-me

# The real roster, on the host and outside git. It's mounted read-only, and only loads into an
# empty arena, so it has to be right before first boot.
ROSTER_FILE=/path/to/roster.json

# Any game.* setting can be overridden here too. .env.example lists them.
