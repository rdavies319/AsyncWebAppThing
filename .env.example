# Every game.* setting with its default, as the environment variables Spring Boot binds
# (GAME_ROUND_INTERVAL is game.round-interval). Copy this to .env and change what you need:
# `docker compose up` loads .env, and `ENV_FILE=.env.dev docker compose up` loads .env.dev instead.
# Without the dev profile, the app won't start until GAME_ROSTER_FILE points at a real roster.
# Every .env* file except the examples is gitignored.

# Betting closes this long before a fight starts
GAME_CUTOFF=10s
# Most one bet can pay out, stake included
GAME_MAX_PAYOUT=10000
GAME_SIGNUP_BONUS=1000
# The daily top-up refills a wallet to this balance
GAME_TOP_UP_TARGET=1000
# The only stakes a bet may have, ascending: the game page's buttons, and all POST /bets accepts
GAME_STAKE_OPTIONS=10,100,500

# When fights start, as a Spring cron expression in UTC (the top of every hour)
GAME_FIGHT_CRON=0 0 * * * *
GAME_ROUND_INTERVAL=1m
# The app refuses to start unless GAME_MAX_ROUNDS × GAME_ROUND_INTERVAL fits between two fight slots
GAME_MAX_ROUNDS=30
# The roster to load on first boot. The default is the dev roster, whose stats are public in git, so
# the app refuses to load it outside the dev profile. The real one lives outside git.
GAME_ROSTER_FILE=classpath:roster-dev.json
# When the engine ticks ("-" turns it off)
GAME_ENGINE_CRON=0 * * * * *

# How many login and signup attempts one IP gets per window, counted separately in memory
GAME_AUTH_LIMITS_LOGIN_MAX_ATTEMPTS=20
GAME_AUTH_LIMITS_LOGIN_WINDOW=15m
GAME_AUTH_LIMITS_SIGNUP_MAX_ATTEMPTS=5
GAME_AUTH_LIMITS_SIGNUP_WINDOW=1h
# Most IPs remembered for each of login and signup, which keeps the app's memory bounded
GAME_AUTH_LIMITS_MAX_TRACKED_IPS=100000

# The dev profile adds the dev panel and /dev/fights/* forcing endpoints. Never in production.
# SPRING_PROFILES_ACTIVE=dev
